# ============================================================================
# Plantilla para docker-compose. Copiar a `.env` y completar los valores.
# `.env` NO se versiona (está en .gitignore); este ejemplo SÍ se versiona.
# ============================================================================

# Contraseña del root de MySQL (contenedor). OBLIGATORIA: docker-compose falla
# si no está definida. Mantenerla alfanumérica (el healthcheck la usa en shell).
MYSQL_ROOT_PASSWORD=cambia-esta-contrasena

# URL que el BROWSER usará para consumir la API (se inlina en build-time en Next).
# En local: localhost:8080 (puerto mapeado del contenedor backend).
# En un deploy remoto: apuntar al dominio/IP del backend.
# También define el origen que la CSP del frontend permite en `connect-src`.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Puerto del HOST donde se expone MySQL del contenedor (default 3306).
# Si XAMPP/MariaDB local ocupa 3306, subirlo a 3307. La red interna del backend
# hacia `db` siempre usa 3306, sin importar este valor.
DB_PORT=3306

# Firma de los tokens de sesión (mínimo 32 caracteres): openssl rand -base64 48
JWT_SECRET=
# Clave inicial del Dueño (debe cambiarla en el primer ingreso)
OWNER_PASSWORD=
# Vigencia en horas de los JWT (default: 4 horas)
JWT_HORAS=4

# Emisor (`iss`) de los JWT. Debe ser el mismo al emitir y al validar.
# Cambiarlo invalida las sesiones abiertas. Default: veterinaria-unla
JWT_ISSUER=veterinaria-unla

# Almacenamiento de rate limiting: 'memory' (default, local) o 'redis' (producción)
RATE_LIMIT_STORAGE=memory
# URL de conexión a Redis (cuando RATE_LIMIT_STORAGE=redis). Ej: redis://:clave@host:6379/0 o rediss://...
REDIS_URL=

# Orígenes permitidos por CORS (lista separada por comas, sin espacios).
# Sin esta variable solo se aceptan los orígenes locales de desarrollo.
# En un despliegue hay que fijar la URL exacta del frontend.
# Ejemplo: CORS_ORIGENES=https://mi-veterinaria.vercel.app
CORS_ORIGENES=http://localhost:3000,http://127.0.0.1:3000

# Logs SQL de Hibernate. Dejar en false en producción; poner true solo para
# depurar consultas en local.
JPA_SHOW_SQL=false
