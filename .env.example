# ============================================================================
# Plantilla para docker-compose. Copiar a `.env` y completar los valores.
# `.env` NO se versiona (está en .gitignore); este ejemplo SÍ se versiona.
# ============================================================================

# Contraseña del root de MySQL (contenedor). OBLIGATORIA: docker-compose falla
# si no está definida. Mantenerla alfanumérica (el healthcheck la usa en shell).
MYSQL_ROOT_PASSWORD=cambia-esta-contrasena

# URL que el BROWSER usará para consumir la API (se inlina en build-time en Next).
# En local: localhost:8080 (puerto mapeado del contenedor backend).
# En un deploy remoto: apuntar al dominio/IP del backend.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Puerto del HOST donde se expone MySQL del contenedor (default 3306).
# Si XAMPP/MariaDB local ocupa 3306, subirlo a 3307. La red interna del backend
# hacia `db` siempre usa 3306, sin importar este valor.
DB_PORT=3306