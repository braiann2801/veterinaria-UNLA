# ============================================================================
# veterinaria-UNLA — .gitignore raíz
# ============================================================================

# ---------- v0 sandbox internal files ----------
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/
.vercel/

# ---------- Environment variables ----------
# .env contiene secretos (Docker Compose, MYSQL_ROOT_PASSWORD): NO versionar.
# .env.example SÍ se versiona como plantilla (no cae en estos patrones).
.env
.env*.local

# ---------- Node / Next.js ----------
node_modules/
.next/
*.tsbuildinfo
*.log
npm-debug.log*
pnpm-debug.log*
.eslintcache

# ---------- Java / Maven (backend) ----------
# backend/.gitignore ya cubre target/ y wrappers; refuerzo a nivel repo.
backend/target/

# ---------- IDEs / editores ----------
.vscode/
.idea/
*.iml
*.ipr
*.iws

# ---------- Sistema operativo ----------
.DS_Store
Thumbs.db